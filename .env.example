# ─────────────────────────────────────────────
#  FAIMS — Environment Variables Template
#  Copy this file to .env and fill in values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
# Database superuser that owns the faims_db schema.
POSTGRES_USER=faims_admin
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=faims_db

# ── JWT ──────────────────────────────────────
# Random secret, minimum 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET_KEY=your_secret_key_min_32_chars_here_change_this

# ── CORS ─────────────────────────────────────
# Comma-separated list of allowed origins for browser clients.
# Leave empty to allow any origin (safe for a mobile-only API).
# Example for a web dashboard: CORS_ALLOWED_ORIGINS=https://faims.yourdomain.com
CORS_ALLOWED_ORIGINS=
